create materialized view MV_83039873
refresh force on demand
as
select BUH_SHEEFR BUH_SHEEFR, ARTICLE_CODE ARTICLE_CODE, to_char(DDATE_FACT, 'yyyy-mm-dd')||'T00:00:00.000Z' DDATE_FACT, NAME_USL NAME_USL, sum(NSUM) NSUM, NUMB NUMB, SAGN_NAME SAGN_NAME, SCONTR_NUMB SCONTR_NUMB, SOTV SOTV, SSTAGE_NUMB SSTAGE_NUMB, ST_BUHNUM ST_BUHNUM, to_char(DEND_DATE, 'yyyy-mm-dd')||'T00:00:00.000Z' DEND_DATE, sum(STAGE_SUMTAX) STAGE_SUMTAX, sum(STAGE_SUM_NDS) STAGE_SUM_NDS, sum(NCOST_SUM) NCOST_SUM from UDO_V_OLAPP_CONTRACT_COST group by BUH_SHEEFR, ARTICLE_CODE, DDATE_FACT, NAME_USL, NUMB, SAGN_NAME, SCONTR_NUMB, SOTV, SSTAGE_NUMB, ST_BUHNUM, DEND_DATE;

