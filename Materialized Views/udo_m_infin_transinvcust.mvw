create materialized view UDO_M_INFIN_TRANSINVCUST
refresh force on demand
as
Select f.regist_num,                      -- kol_b Номер документа
       f.regist_date,                     -- kol_c Дата документа
       f.regist_period,
       f."p20"             as nDOC_SUM,      -- kol_d Сумма по документу
       f."p33"             as nAGENT_kls_id, -- kls_id Грузополучателя
       al0.kls_num         as sAGENT_Num,   -- kol_e Грузополучатель Ном
       al0.kls_name        as sAGENT_Name,  -- kol_f Грузополучатель Наим
       al1.kls_num         as sZAK_Num,     -- kol_g Заказ Ном
       al1.kls_name        as sZAK_Name     -- kol_h Заказ Наим
  from t_reestr_3@infin f
      ,t_kls_all@infin  al0
      ,t_kls_all@infin  al1
 where al0.kls_id (+) = f."p33"
   and al1.kls_id (+) = f."p40";

