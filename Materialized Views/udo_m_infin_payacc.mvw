create materialized view UDO_M_INFIN_PAYACC
refresh force on demand
as
Select f.regist_num  as regist_num,        -- kol_b Номер документа
       f.regist_date as regist_date,       -- kol_c Дата документа
       f."p29"       as nDocSum,           -- kol_d Сумма по документу
       f."p26"       as nSum_NDS,          -- Сумма НДС
       f."p11"       as nSum_WONDS,        -- Сумма без НДС
       al0.kls_num   as sAGENT_NOM,        -- kol_e Покупатель Ном
       f."p4"        as nAGENT_kls_id,     -- kls_id Покупателя
       al0.kls_name  as sAGENT_NAME,       -- kol_f Покупатель Наим
       al1.kls_num   as sZak_NOM,          -- kol_g Номер заказа Номер
       al1.kls_name  as sZAK_NAME,         -- kol_h Номер заказа Наимен
       f."p27"       as sPayNote
  from t_reestr_14@infin f
      ,t_kls_all@infin   al0
      ,t_kls_all@infin   al1
 where al0.kls_id (+) = f."p4"
   and al1.kls_id (+) = f."p31"
   and al1.kls_num is not null
   and al1.kls_num <> '00';

