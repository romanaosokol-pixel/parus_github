create materialized view UDO_M_INFIN_AGNLIST
refresh force on demand
as
Select a.kls_num                     as nKLS_NUM       --Kol_B,
      ,a.kls_id                      as nKLS_ID        --Kol_C,
      ,trim(a.kls_name)              as sAGNENT_NAME   --Kol_D,
      ,d.naim_all || d.naim2         as sAGNENT_FULLNAME   --Kol_E,
      ,d.INN                         as sAGNIDNUMB      --Kol_F,
      ,d."p19"                       as sAGNREASON      --Kol_G,
      ,d.Bank || d.Bank2 || d.Bank3  as sBANKName       --Kol_H,
      ,d.MFO                         as nBANKBIK        --Kol_I,
      ,d.CH                          as nAGNCHET        --Kol_J,
      ,d.KORR                        as nBANKKORR       --Kol_K,
      ,d.ADDRESS                     as sAGNADRESS      --Kol_L,
      ,d."p23"                       as sAGNADRESS2     --Kol_M,
      ,d."p20"                       as sAGNADRESS3     --Kol_N
      ,d.period_beg
      ,d.period_end
  from t_kls_all@INFIN a, t_klsd_6@INFIN d
 where a.kls_id = d.kls_id
   and trim(a.kls_name) is not null;

