create materialized view UDO_M_INFIN_DOGNUM
refresh force on demand
as
select
       a.kls_num
      ,a.kls_name
      ,a.klsref_num
      ,d."p24"
  from t_kls_all@infin a
      ,t_klsd_5@infin  d
 where a.kls_id = d.kls_id
   and a.klsref_num = 5
   and a.kls_num  is not null
   and trim(a.kls_name) is not null;

