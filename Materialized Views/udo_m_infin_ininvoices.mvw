create materialized view UDO_M_INFIN_ININVOICES
refresh force on demand
as
Select f.regist_num,                    -- kol_b Номер документа
       f.regist_date,                   -- kol_c Дата документа
       f.nDOC_SUM,      -- kol_d Сумма по документу
       f.nAGENT_kls_id, -- kls_id Грузополучателя
       f.sAGENT_Num,   -- kol_e Грузополучатель Ном
       f.sAGENT_Name,  -- kol_f Грузополучатель Наим
       f.sZAK_Num,     -- kol_g Заказ Ном
       f.sZAK_Name     -- kol_h Заказ Наим
  from udo_v_infin_ininvoices f;

