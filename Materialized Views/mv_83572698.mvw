create materialized view MV_83572698
refresh force on demand
as
select sum(NQUANT) NQUANT, sum(NQUANT_SPEC) NQUANT_SPEC, SFACTORY_NUMB SFACTORY_NUMB, SMATRES_NAME SMATRES_NAME, SPROD_ORDER SPROD_ORDER, SP_MATRES_CODE SP_MATRES_CODE, SP_MATRES_NAME SP_MATRES_NAME, SSTORE SSTORE, STEMA STEMA, SZAKAZ_REQ SZAKAZ_REQ, SNOMEN_TYPE SNOMEN_TYPE, SSERNUMB SSERNUMB, to_char(DDOCDATE, 'yyyy-mm-dd')||'T00:00:00.000Z' DDOCDATE from UDO_V_OLAPP_FCDELIVSH group by SFACTORY_NUMB, SMATRES_NAME, SPROD_ORDER, SP_MATRES_CODE, SP_MATRES_NAME, SSTORE, STEMA, SZAKAZ_REQ, SNOMEN_TYPE, SSERNUMB, DDOCDATE;

