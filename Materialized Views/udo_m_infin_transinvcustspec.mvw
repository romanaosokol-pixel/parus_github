create materialized view UDO_M_INFIN_TRANSINVCUSTSPEC
refresh force on demand
as
Select t.regist_num,                      --  Номер документа
       t.regist_period,                   --
       trunc(t.input_date)     as dinput_date,  --
       trunc(t.creat_date)     as dcreat_date,
       t."p11"                 as nQuant,        --  Количество по позиции
       t."p24"                 as nPrice,        --  Цена позиции
       t."p17"                 as nSumm,         --  Сумма по позиции
       t."p37"                 as nkls_id,
       all0.kls_num            as nTaxRate,       -- Налоговая ставка
       all0.kls_name           as sTaxRate,       -- Налоговая ставка
       all1.kls_num            as sNomen_Num,     -- Наименование нименклатуры
       all1.kls_name           as sNomen_Name,    -- Наименование нименклатуры
       all1.klsref_num         as nFLSREF_Num     -- Номер справочника
  from t_creestr_3@infin t
      ,t_kls_all@infin  all0
      ,t_kls_all@infin  all1
  where  all0.kls_id (+) = t."p9"
    and  all1.kls_id (+) = t."p37";

